# （3）数据预处理
# 1、需要处理的动作：1、删除缺失值 2、过滤出金额 3、固定时间节点以每年最后一天为参考时间
for i in sheet_name[:-1]:
    # 1、删除缺失值
    data[i]=data[i].dropna()
    # 2、过滤出金额>1的订单
    data[i]=data[i].query('订单金额>1')
    # 方式二：data[布尔series]做筛选！！！
    # data[i]=data[i][data[i]['订单金额']>1]
    # 3、固定时间节点，以每年最后1天当作当年的分析点
    data[i]['max_year_date']=data[i]['提交日期'].max()
# 5、查看处理后的数据
# for i in sheet_name[:-1]:
#     print(data[i].info())
#     print(data[i].describe())
# 问题分析：缺失值，垃圾数，日期参考已处理，但索引值和总数据个数不匹配！！！（原因：删除缺失值过程中index错乱）
# 6、找到差异值进行合并表格（列合并+产生一列特值）
info=list(data.values())[:-1]  # 把四个表格的DataFrame对象拿过来放入列表！！！
# print(type(info))
info1=pd.concat(info,ignore_index=True)  # 表列合并，并且重置索引(ignor_index)！！！
# print(info1.info())
# print(info1.describe().T)
info1['year']=info1['提交日期'].dt.year   # 新增区分值一列，彻底融合四表！！！
# print(info1)
# 7、生成每个订单的日期差
info1['lastest_date']=info1["max_year_date"]-info1['提交日期']
info1['lastest_date']=info1['lastest_date'].dt.days
# print(info1)
# 8、R、F、M的产生 ， 注意1:分组的本质是根据分组值重新生成一个表格；注意2：分组后分组字段会变成索引，因此要加as_index=False；注意3：分组后赋值，把所有的分类组别放同一个表里！！！
info2=info1.groupby(['year','会员ID'],as_index=False).agg({
    'lastest_date':'min',
    '订单号':'count',
    '订单金额':'sum'
})
info2.columns=['year','会员ID','r','f','m']
# print(info2)
# # 结果分析：已分组后产生r/f/m列，接着给r/f/m进行区间划分后打分
# # 9、区间划分后打分：划分区间，分别给出：RFM的评分，依据：r:最近一次的购买时间 越小分越高，f：购买次数 越大分越高，m:购买金额 越大分越高
# # 给区间确立边界：
r_bins=[-1,79,255,365]
info2['set_interval_r']=pd.cut(info2.r,bins=r_bins,labels=[3,2,1]) # 注意：cut读取bins包右不包左！！！
# print(info2['set_interval'])                    # 含义解析：新生成一列区间，和r进行对应！！！
# 同理对f和m生成区间列
f_bins=[0,2,5,130]
info2['set_interval_f']=pd.cut(info2.f,bins=f_bins,labels=[1,2,3])
m_bins=[1,69,1199,206252]
info2['set_interval_m']=pd.cut(info2.m,bins=m_bins,labels=[1,2,3])
# print(info2)

# 打分操作：在区间的基础上，贴上label把区间列变成分数,操作参考上！！！
